<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>TradeTogether 0.8.1 STRPM bridge branch</moduleName>
  <requiredInstallFiles>
    <folder source="00 Core" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Network profile">
      <optionalFileGroups order="Explicit">
        <group name="Which profile should be installed?" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Client / Local">
              <description>Default profile for local play and remote clients. Uses STRPluginMessagingAPI when available, without requiring a TradeTogether UDP port forward.</description>
              <files>
                <folder source="10 Client Local" destination="" priority="10" />
              </files>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="Host">
              <description>Host-labelled profile for future STRPlugin role-specific behavior. No TradeTogether UDP port forward is required in STRPlugin transport mode.</description>
              <files>
                <folder source="20 Host" destination="" priority="20" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
