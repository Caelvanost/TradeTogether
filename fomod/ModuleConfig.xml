<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>TradeTogether 0.7.1</moduleName>
  <requiredInstallFiles>
    <folder source="00 Core" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Network profile">
      <optionalFileGroups order="Explicit">
        <group name="Which profile should be installed?" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Client / Local">
              <description>Default profile for local play and remote clients. LAN discovery stays enabled, and remote clients automatically reuse STR's saved direct-connect host when available.</description>
              <files>
                <folder source="10 Client Local" destination="" priority="10" />
              </files>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="Host">
              <description>Use this only on the Skyrim Together host / relay machine. You must forward UDP port 27993 to this PC and allow UDP 27993 in Windows Firewall. Remote clients can stay on Client / Local.</description>
              <files>
                <folder source="20 Host" destination="" priority="20" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
